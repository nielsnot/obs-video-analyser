uniform float4x4 ViewProj;
uniform texture2d image;
uniform float zebra_th_low;
uniform float zebra_th_high;
uniform float zebra_tm;
uniform float zebra_dx = 1.0;  // stripe direction: x and y weights (1, 1) is "/", (1, -1) is "\"
uniform float zebra_dy = 1.0;
uniform float zebra_anim = 1.0; // 0: still stripes
uniform float skin_on = 0.0;    // 1: a second zebra across the first, for skin tones
uniform float skin_low = 0.6;
uniform float skin_high = 0.7;
uniform texture2d raw; // the raw signal of a video source: legal luma code (16 is 0 %, 235 is 100 %)

sampler_state def_sampler {
	Filter   = Linear;
	AddressU = Clamp;
	AddressV = Clamp;
};

struct VertInOut {
	float4 pos : POSITION;
	float2 uv  : TEXCOORD0;
};

VertInOut VSDefault(VertInOut vert_in)
{
	VertInOut vert_out;
	vert_out.pos = mul(float4(vert_in.pos.xyz, 1.0), ViewProj);
	vert_out.uv  = vert_in.uv;
	return vert_out;
}

// 1 for the scope sources: pixels outside the dock's selection have alpha 0 and are shown dark.
uniform float mask_outside = 0.0;

float4 outside_selection(float4 rgba)
{
	float g = dot(rgba.xyz, float3(0.2126, 0.7152, 0.0722)) * 0.3;
	return float4(g, g, g, 1.0);
}

sampler_state raw_sampler {
	Filter   = Point;
	AddressU = Clamp;
	AddressV = Clamp;
};


// Stripes 3 pixels wide every 6, moving unless still; the skin zebra crosses them in light grey.
float4 zebra_apply(float4 rgba, float2 pos, float y, bool upper_open)
{
	float t = zebra_tm * zebra_anim;
	if (zebra_th_low <= y && (y <= zebra_th_high || upper_open)) {
		if (frac((pos.x * zebra_dx + pos.y * zebra_dy + t) / 6.0) < 0.5)
			return float4(0.0, 0.0, 0.0, 1.0);
		return rgba;
	}
	if (skin_on > 0.5 && skin_low <= y && y <= skin_high) {
		if (frac((pos.x * zebra_dx - pos.y * zebra_dy + t) / 6.0) < 0.34)
			return float4(0.85, 0.85, 0.85, 1.0);
	}
	return rgba;
}

// Stripes from the raw luma, which goes beyond 0 % and 100 %; a high threshold of 100 % has no upper limit.
float4 PSDrawZebraRaw(VertInOut vert_in) : TARGET
{
	float4 rgba = image.Sample(def_sampler, vert_in.uv);
	if (mask_outside > 0.5 && rgba.a < 0.5)
		return outside_selection(rgba);
	float y = (raw.Sample(raw_sampler, vert_in.uv).r * 255.0 - 16.0) / 219.0;
	return zebra_apply(rgba, vert_in.pos.xy, y, zebra_th_high >= 0.999);
}

technique DrawZebraRaw
{
	pass
	{
		vertex_shader = VSDefault(vert_in);
		pixel_shader  = PSDrawZebraRaw(vert_in);
	}
}

float4 PSDrawZebra601(VertInOut vert_in) : TARGET
{
	float4 rgba = image.Sample(def_sampler, vert_in.uv);
	if (mask_outside > 0.5 && rgba.a < 0.5)
		return outside_selection(rgba);
	float y = dot(rgba.xyz, float3(0.299000, 0.587000, 0.114000));
	return zebra_apply(rgba, vert_in.pos.xy, y, false);
}

float4 PSDrawZebra709(VertInOut vert_in) : TARGET
{
	float4 rgba = image.Sample(def_sampler, vert_in.uv);
	if (mask_outside > 0.5 && rgba.a < 0.5)
		return outside_selection(rgba);
	float y = dot(rgba.xyz, float3(0.212600, 0.715200, 0.072200));
	return zebra_apply(rgba, vert_in.pos.xy, y, false);
}

float4 PSDrawZebra2020(VertInOut vert_in) : TARGET
{
	float4 rgba = image.Sample(def_sampler, vert_in.uv);
	if (mask_outside > 0.5 && rgba.a < 0.5)
		return outside_selection(rgba);
	float y = dot(rgba.xyz, float3(0.262700, 0.678000, 0.059300));
	return zebra_apply(rgba, vert_in.pos.xy, y, false);
}

technique DrawZebra601
{
	pass
	{
		vertex_shader = VSDefault(vert_in);
		pixel_shader  = PSDrawZebra601(vert_in);
	}
}
technique DrawZebra709
{
	pass
	{
		vertex_shader = VSDefault(vert_in);
		pixel_shader  = PSDrawZebra709(vert_in);
	}
}

technique DrawZebra2020
{
	pass
	{
		vertex_shader = VSDefault(vert_in);
		pixel_shader  = PSDrawZebra2020(vert_in);
	}
}
